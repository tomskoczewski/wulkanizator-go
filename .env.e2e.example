# Copy to .env.e2e (gitignored) before running `npm run test:e2e`.
# Values below are the defaults of the local Supabase stack (`npm run db:start`).
E2E_BASE_URL=http://localhost:4321
E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Fixture accounts from supabase/seed.sql — owner A and owner B own *different* workshops,
# which is what the cross-workshop denial test needs.
E2E_OWNER_A_EMAIL=owner-a@example.com
E2E_OWNER_A_PASSWORD=password123
E2E_OWNER_B_EMAIL=owner-b@example.com
E2E_OWNER_B_PASSWORD=password123
