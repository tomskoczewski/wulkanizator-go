---
import AppShell from "@/layouts/AppShell.astro";
import DayPlanBoard from "@/components/appointments/DayPlanBoard";
import { getDayPlan } from "@/lib/services/appointments";
import { resolveDayParam } from "@/lib/schemas/day-plan";
import { shiftDateString, workshopTodayDateString } from "@/lib/workshop-clock";

const { profile, supabase } = Astro.locals;

const today = workshopTodayDateString();
const date = resolveDayParam(Astro.url.searchParams.get("data"));
const plan = supabase ? await getDayPlan(supabase, date) : null;
---

<AppShell
  title="Dzień dobry — plan dnia"
  active="Dzisiaj"
  ctaLabel="Nowa wizyta"
  ctaHref={profile?.role === "owner" ? "/wizyty/nowa" : undefined}
>
  {
    plan ? (
      <DayPlanBoard
        client:load
        entries={plan.entries}
        workingHours={plan.workingHours}
        date={date}
        prevDate={shiftDateString(date, -1)}
        nextDate={shiftDateString(date, 1)}
        today={today}
      />
    ) : (
      <div class="rounded-2xl bg-white p-4 text-sm font-semibold text-slate-600 shadow-sm ring-1 ring-slate-100">
        Supabase nie jest skonfigurowany.
      </div>
    )
  }
</AppShell>
