---
import AuthLayout from "@/layouts/AuthLayout.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<AuthLayout title="Rejestracja" heading="Załóż konto" subheading="Zakładasz konto właściciela nowego warsztatu.">
  <SignUpForm serverError={error} client:load />
  <p class="mt-5 text-center text-xs font-semibold text-slate-500">
    Masz już konto? <a href="/auth/signin" class="font-black text-orange-600 hover:underline">Zaloguj się</a>
  </p>
</AuthLayout>
