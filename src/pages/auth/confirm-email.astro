---
import AuthLayout from "@/layouts/AuthLayout.astro";
import { CircleCheck, Mail } from "lucide-react";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      icon: CircleCheck,
      heading: "Konto utworzone",
      description: "Twoje konto jest gotowe. Możesz się zalogować.",
      linkText: "Przejdź do logowania",
    }
  : {
      icon: Mail,
      heading: "Sprawdź skrzynkę",
      description: "Wysłaliśmy link aktywacyjny na Twój adres e-mail. Kliknij go, aby aktywować konto.",
      linkText: "Wróć do logowania",
    };
---

<AuthLayout title={content.heading} heading={content.heading}>
  <div class="text-center">
    <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-2xl bg-orange-50 text-orange-600">
      <content.icon size={24} />
    </div>
    <p class="mb-6 text-sm font-semibold text-slate-600">{content.description}</p>
    <a
      href="/auth/signin"
      class="inline-block w-full rounded-xl bg-orange-500 py-3 text-sm font-black text-white hover:bg-orange-600"
    >
      {content.linkText}
    </a>
  </div>
</AuthLayout>
