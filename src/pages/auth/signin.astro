---
import AuthLayout from "@/layouts/AuthLayout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<AuthLayout title="Logowanie" heading="Zaloguj się" subheading="Wejdź do planu dnia swojego warsztatu.">
  <SignInForm serverError={error} client:load />
  <p class="mt-5 text-center text-xs font-semibold text-slate-500">
    Nie masz konta? <a href="/auth/signup" class="font-black text-orange-600 hover:underline">Załóż konto</a>
  </p>
</AuthLayout>
