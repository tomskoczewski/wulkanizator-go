if ! npx supabase status >/dev/null 2>&1; then
  echo "pre-push: Supabase local stack is not running — skipping types-drift check."
  exit 0
fi

npm run db:types >/dev/null 2>&1

if ! git diff --quiet -- src/db/database.types.ts; then
  echo "pre-push: src/db/database.types.ts is out of date with the local schema."
  echo "Run 'npm run db:types' and commit the result before pushing."
  exit 1
fi
